{"status": 403, "headers": {"content-type": "text/html; charset=utf-8"}, "body": "<!DOCTYPE html><html lang=\"en\"><head><meta id=\"zh-zse-ck\" charset=\"UTF-8\" content=\"Pt1xZ/rQFeYHDGvKYcqKWBA02nOX+/7mi/PJmfROjkZ7VzCkW/xLsveiohxJ1tS+pygpo1iIB7HPRJ5MWTzC2YPjKe7LfSHoceyJqOXqGWsT3XJ98Vxx90NUjYT2Nqrh7jWDi3OUCM74opHYWSCezC0GY+ERSN4IBW3eiglyHhM=\"></head><body><div>zh</div><script src=\"https://static.zhihu.com/zse-ck/v4/e3bb840260cd9ef11c695e77ff2a204706f301cea36cd903191bb01fd471f4a4.js\"></script><script>\n(function(){\n  var hist=[], lastI=-1, n=0;\n  var t=setInterval(function(){\n    n++;\n    try{\n      var c=window.__c;\n      if(c && typeof c.i==='number' && c.i!==lastI){\n        lastI=c.i;\n        var g=c.G;\n        hist.push(c.i+'|G'+(Array.isArray(g)?g.length:'?')+'|qh='+(typeof c.qh==='string'?('s'+c.qh.length):String(c.qh)));\n        localStorage.setItem('__hist',JSON.stringify(hist));\n        if(hist.length>=400) clearInterval(t);\n      }\n    }catch(e){ localStorage.setItem('__hist','ERR '+e.message); clearInterval(t); }\n    if(n>20000) clearInterval(t);\n  },1);\n})();\n</script>\n</body></html>\n\n"}
