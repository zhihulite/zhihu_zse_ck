{"status": 403, "headers": {"content-type": "text/html; charset=utf-8"}, "body": "<!DOCTYPE html><html lang=\"en\"><head><meta id=\"zh-zse-ck\" charset=\"UTF-8\" content=\"JCyDbLa+KyYeW8YdiFmPu+H2fFLhp3FQTpHN9CXUx8mr4i0rb6vFQ2JufZcAMbFoBiSW1dAwL4WAuZU0ePqFL+zfYNhcIc7TFGjLs0WGV/0Yu067Nq+E86qhx/0+0spx9VRIqZLB3NHBgNSyyRSPERsYmv9194l1ngEb8HscKg0=\"></head><body><div>zh</div><script src=\"https://static.zhihu.com/zse-ck/v4/ff299bd7eb97e7ba57e36860a0bdcf6b89a831dcdd23a76851b5716ac86f268e.js\"></script><script>\n(function(){\n  var samples=[], n=0;\n  var t=setInterval(function(){\n    n++;\n    try{\n      var c=window.__c;\n      if(c && Array.isArray(c.G)) samples.push(c.G.length + '/' + (typeof c.qh==='string'?('q'+c.qh.length):'q-'));\n      else samples.push('noC');\n      localStorage.setItem('__gs', JSON.stringify({n:n, s:samples}));\n    }catch(e){}\n    if(n>120) clearInterval(t);\n  },100);\n})();\n</script>\n</body></html>"}